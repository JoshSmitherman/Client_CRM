# ---------------------------------------------------------------------------
# Supabase — copy this file to .env.local and fill in your own project values.
# Find these at: Supabase Dashboard > Project Settings > API
# ---------------------------------------------------------------------------

# Both of these are compiled into the browser bundle. That is by design:
# the anon key can only reach what Row Level Security allows, which for a
# signed-out visitor is nothing at all.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---------------------------------------------------------------------------
# NOT used by the browser application, and never committed.
#
# The service role key bypasses Row Level Security completely. It belongs in
# two places only:
#   - Supabase  -> Edge Functions -> Secrets   (for issuing client logins)
#   - GitHub    -> Actions secrets             (for the scheduled sweep)
# ---------------------------------------------------------------------------
