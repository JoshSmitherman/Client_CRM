# ---------------------------------------------------------------------------
# Supabase — copy this file to .env.local and fill in your own project values.
# Find these at: Supabase Dashboard > Project Settings > API
# ---------------------------------------------------------------------------

# Safe to expose to the browser (protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Never commit.
# Used solely for inviting users and the reminder sweep.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL of this app (used to build invitation + reset links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret required by POST /api/reminders/sweep (cron endpoint).
REMINDER_SWEEP_SECRET=generate-a-long-random-string
